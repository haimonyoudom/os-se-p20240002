#!/bin/bash
SRC="$HOME/sample_project"
DEST="$HOME/project_backups"
mkdir -p "$DEST"

TIMESTAMP=$(date '+%Y%m%d_%H%M%S')
ARCHIVE="$DEST/backup_$TIMESTAMP.tar.gz"

tar -czf "$ARCHIVE" -C "$HOME" sample_project
echo "$(date): Created $ARCHIVE"

# Keep only newest 4
ls -t "$DEST"/backup_*.tar.gz | tail -n +5 | xargs -r rm --
echo "Archives kept:"
ls -lh "$DEST"/backup_*.tar.gz
